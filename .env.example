# ============================================================
#  SOC / SIEM Platform — Environment Template
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ============================================================

# ── Seed Admin Account ────────────────────────────────────────────────────────

# Credentials for the built-in superuser created on first run.
# Change the password immediately after first login.
SEED_ADMIN_USERNAME=seed_admin
SEED_ADMIN_EMAIL=admin@soc.local
SEED_ADMIN_PASSWORD=your-strong-password-here

# ── Flask Core ────────────────────────────────────────────────────────────────

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-before-deploy

# 'development' = HTTP cookies, verbose errors
# 'production'  = secure HTTPS-only cookies, no debug output
FLASK_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────

# SQLite (default — no setup required)
# SQLALCHEMY_DATABASE_URI=sqlite:///users.db

# PostgreSQL (uncomment and configure for production scale)
# SQLALCHEMY_DATABASE_URI=postgresql://soc_user:password@localhost:5432/soc_db

# SQL Server via ODBC (Windows)
# SQLALCHEMY_DATABASE_URI=mssql+pyodbc://user:pass@server/soc_db?driver=ODBC+Driver+17+for+SQL+Server

# ── Session Security ──────────────────────────────────────────────────────────

# Session lifetime in seconds (default: 604800 = 7 days)
# PERMANENT_SESSION_LIFETIME=604800

# ── Rate Limiting ─────────────────────────────────────────────────────────────

# Override the default 300/minute per-IP limit
# RATELIMIT_DEFAULT=300 per minute

# Set to false to disable rate limiting entirely (not recommended)
# RATELIMIT_ENABLED=true

# ── Network / Capture ─────────────────────────────────────────────────────────

# Override sniffer interface (auto-detected by default)
# CAPTURE_INTERFACE=eth0

# ── Syslog Ingester ───────────────────────────────────────────────────────────

# UDP port to receive syslog messages (requires admin/root for port < 1024)
# SYSLOG_PORT=514
# SYSLOG_HOST=0.0.0.0

# ── Notifications (optional) ──────────────────────────────────────────────────

# Slack webhook for critical alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Discord webhook for critical alerts
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
